<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark background for the home-screen widget.
     Uses the same dark navy (#0A0E14) as the app theme, with rounded corners
     and a subtle neon-green border to match the in-app aesthetic. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0A0E14" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#243044" />
</shape>
