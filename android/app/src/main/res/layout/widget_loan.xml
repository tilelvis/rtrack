<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget layout for Loan Tracker.
     Dark near-black background (#0A0E14) with neon-green accents.
     Layout:
       Row 1: App name (small) + dot indicator
       Row 2: Loan title (large)
       Row 3: Balance (large neon green) + progress %
       Row 4: "Due 25 Dec" + "Ksh 500/interval"
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="#39FF14"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/widget_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOAN TRACKER"
            android:textColor="#9BA8C0"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <!-- Loan title -->
    <TextView
        android:id="@+id/widget_loan_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#F5F7FA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <!-- Balance + progress % -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ksh 0"
            android:textColor="#39FF14"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_progress_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#39FF14"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#39FF14"
        android:progressBackgroundTint="#243044"
        android:layout_marginBottom="6dp" />

    <!-- Footer row: due date + amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_next_due"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Due —"
            android:textColor="#9BA8C0"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_daily_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#9BA8C0"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
